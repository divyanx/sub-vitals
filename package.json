{
  "name": "sub-vitals",
  "version": "0.0.0",
  "private": true,
  "description": "Native CX analytics for Reddit brand communities — issue taxonomy, sentiment, agent verification, response analytics. Built on Devvit Web.",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "devvit playtest",
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build && node scripts/check-bundle-size.js",
    "type-check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "deploy": "devvit upload",
    "launch": "devvit publish",
    "prepare": "simple-git-hooks",
    "seed:demo": "tsx scripts/seed-demo-data.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@devvit/start": "0.12.24-next-2026-05-14-23-46-48-630b04b92.0",
    "@devvit/web": "0.12.24-next-2026-05-14-23-46-48-630b04b92.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hono/node-server": "2.0.2",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "5.100.10",
    "ai": "^6.0.184",
    "hono": "4.12.19",
    "p-retry": "^8.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "remark-gfm": "^4.0.1",
    "sentiment": "5.0.2",
    "tinykeys": "^3.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.4.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sentiment": "5.0.4",
    "@vitejs/plugin-react": "6.0.2",
    "devvit": "0.12.24-next-2026-05-14-23-46-48-630b04b92.0",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "serve": "^14.2.6",
    "simple-git-hooks": "2.13.1",
    "snoowrap": "^1.23.0",
    "storybook": "^10.4.0",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.1",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run type-check && npm run test"
  }
}
