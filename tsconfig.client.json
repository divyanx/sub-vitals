{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "customConditions": ["browser"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/client/**/*", "src/stories/**/*", ".storybook/**/*"],
  "exclude": [
    "src/server/**/*",
    "src/shared/**/*",
    "src/modules/**/*",
    "tests/**/*",
    "node_modules",
    "dist"
  ]
}
